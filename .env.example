# ---------------------------------------------------------------------------
# Cash Atlas — FRONTEND environment (Vite)
# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. NEVER commit real values.
#
# Everything prefixed with VITE_ is embedded into the JavaScript bundle and is
# therefore PUBLIC. Only publishable / anon-tier values belong here.
#
# Server-side secrets (PLAID_SECRET, ANTHROPIC_API_KEY,
# ACCESS_TOKEN_ENCRYPTION_KEY, service-role keys) are configured as Supabase
# Edge Function secrets — see MANUAL_SETUP.md. They must never appear below.
# ---------------------------------------------------------------------------

# Supabase project URL.
#   Local:  http://127.0.0.1:54321  (printed by `pnpm db:start`)
#   Remote: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (`sb_publishable_...`), or the legacy anon key for
# older projects. Safe to expose: it is constrained by Row Level Security.
#   Local:  printed by `pnpm db:start`
#   Remote: Supabase Dashboard → Project Settings → API Keys
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Public site URL used for auth redirect callbacks.
# Leave blank to use the browser's current origin.
VITE_APP_URL=
